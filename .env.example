# --- LiveKit (Cloud or self-hosted) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Voice pipeline providers ---
DEEPGRAM_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
CARTESIA_API_KEY=
# Optional: per-firm branded voice (Cartesia voice id). Empty = provider default.
CARTESIA_VOICE_ID=

# --- LLM providers (add a key to unlock that provider in Config Studio) ---
# Each firm picks provider:model in the dashboard; the worker reads the matching
# key here at call time. A provider whose key is missing is skipped (the call
# falls back to the next configured provider). Add only the ones you use.
ANTHROPIC_API_KEY=        # Claude — claude-haiku-4-5, claude-sonnet-5, claude-opus-4-8
OPENAI_API_KEY=           # gpt-5.4-mini, gpt-5.4-nano, gpt-5.4, gpt-5.5, gpt-4.1
GEMINI_API_KEY=           # Google Gemini — gemini-flash-latest, gemini-3.5-flash
# DEEPSEEK_API_KEY / GROQ_API_KEY set above under voice pipeline
#   DeepSeek now: deepseek-v4-flash, deepseek-v4-pro (deepseek-chat EOL 2026-07-24)
#   Groq now: openai/gpt-oss-20b, openai/gpt-oss-120b (llama-3.3 deprecated)
XAI_API_KEY=              # xAI Grok — grok-4.1-fast, grok-4.5, grok-4.3
MISTRAL_API_KEY=          # mistral-large-latest, mistral-small-latest
TOGETHER_API_KEY=         # Together AI — meta-llama/Llama-3.3-70B-Instruct-Turbo, Qwen/Qwen3.5-9B
FIREWORKS_API_KEY=        # Fireworks — accounts/fireworks/models/gpt-oss-120b
OPENROUTER_API_KEY=       # OpenRouter (routes to any model, e.g. openai/gpt-5.4-mini)
PERPLEXITY_API_KEY=       # sonar, sonar-pro, sonar-reasoning
CEREBRAS_API_KEY=         # gpt-oss-120b, zai-glm-4.7, llama-4-scout
# Ollama needs no key (local); runs at http://localhost:11434

# --- Caseline backend ---
CASELINE_BACKEND_URL=http://localhost:8000
# SQLite path for the Phase 0 throwaway store
CASELINE_DB=caseline.db

# --- Phase 1 platform (multi-tenant /v1 API mounts when DATABASE_URL is set) ---
# Postgres, e.g. postgresql://user:pass@localhost:5432/caseline
CASELINE_DATABASE_URL=
# Fernet key for encrypting CMS credentials at rest. Generate with:
#   uv run python -c "from api.platform.secrets import FernetCipher; print(FernetCipher.generate_key())"
CASELINE_SECRETS_KEY=
# On GCP, use Cloud KMS instead of the Fernet key:
# CASELINE_KMS_KEY_NAME=projects/.../locations/.../keyRings/.../cryptoKeys/...
# Shared secret for the /v1/admin/* onboarding endpoints
CASELINE_ADMIN_TOKEN=
# Redis for live session state + config cache (empty = in-process memory)
CASELINE_REDIS_URL=
# Firm service token for the voice worker (issued at onboarding). When set,
# the worker and dashboard use the multi-tenant /v1 API; when empty the
# worker falls back to the Phase 0 prototype endpoints.
CASELINE_FIRM_TOKEN=
# Per-token API rate limit
CASELINE_RATE_LIMIT_PER_MINUTE=300
# Event worker poll interval (seconds)
CASELINE_WORKER_POLL_SECONDS=1.0

# --- Outbound SMS (empty = logged, not sent) ---
# Provider is auto-selected: Plivo if its auth pair is set, else Twilio, else
# a logging no-op. Set only one provider's credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Plivo (Account > Keys & Credentials in the console); number in E.164.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=

# Master switch for OUTBOUND SMS (default true). Credentials being present is
# not the same as being allowed to send: a US long code is rejected until it is
# mapped to an approved A2P 10DLC campaign, and that approval is invisible from
# config. Set false to stop the agent offering a confirmation text it can't
# deliver (it confirms the booking verbally instead); flip back to true once
# the 10DLC registration clears. Read by BOTH the API and the agent worker.
CASELINE_SMS_ENABLED=true

# --- Phase 2 hardening ---
# Provider failover stacks: comma-separated "provider:model", primary first.
# Single entry = no failover (Phase 0/1 behavior). OpenAI entries need OPENAI_API_KEY.
CASELINE_STT_PROVIDERS=deepgram:nova-3
# Fast + efficient balance for live calls: Claude Haiku 4.5 (natural, reliable
# native tool-caller) with DeepSeek V4 Flash failover. Both are the low-latency
# "flash/mini" tier, not the flagships. Per-firm overrides in Config Studio.
CASELINE_LLM_PROVIDERS=anthropic:claude-haiku-4-5,deepseek:deepseek-v4-flash
CASELINE_TTS_PROVIDERS=cartesia:sonic-3
# OPENAI_API_KEY=
# DB pool per API process — size for expected concurrent calls (see load test)
CASELINE_DB_POOL_SIZE=4
# Event worker claim batch (backpressure bound) + alert cadence
CASELINE_WORKER_BATCH_SIZE=20
CASELINE_ALERT_INTERVAL_SECONDS=60
# Webhook (Slack-compatible) for pushed alerts; empty = log only
CASELINE_ALERT_WEBHOOK_URL=

# --- Phase 3 omnichannel ---
# Outbound email channel (empty = logged, not sent)
CASELINE_SMTP_HOST=
CASELINE_SMTP_PORT=587
CASELINE_SMTP_USERNAME=
CASELINE_SMTP_PASSWORD=
CASELINE_SMTP_FROM=intake@caseline.app
# LiveKit SIP outbound trunk for the Digital Lead Chaser's voice path
# (empty = dials are logged, not placed). Created by scripts/plivo_trunk_setup.sh.
CASELINE_SIP_OUTBOUND_TRUNK_ID=
# LiveKit Cloud SIP URI (console > Settings > SIP URI) — the PROJECT-ID
# subdomain, not the media-URL one. Plivo's inbound trunk origination points here.
LIVEKIT_SIP_URI=
# Plivo Zentrunk outbound (termination) domain + optional SIP creds, for the
# LiveKit outbound trunk (see deploy/plivo-trunk.md).
PLIVO_SIP_TERMINATION=
PLIVO_SIP_USERNAME=
PLIVO_SIP_PASSWORD=
