# --- LiveKit (Cloud or self-hosted) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Voice pipeline providers ---
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
# Optional: per-firm branded voice (Cartesia voice id). Empty = provider default.
CARTESIA_VOICE_ID=

# --- Caseline backend ---
CASELINE_BACKEND_URL=http://localhost:8000
# SQLite path for the Phase 0 throwaway store
CASELINE_DB=caseline.db

# --- Phase 1 platform (multi-tenant /v1 API mounts when DATABASE_URL is set) ---
# Postgres, e.g. postgresql://user:pass@localhost:5432/caseline
CASELINE_DATABASE_URL=
# Fernet key for encrypting CMS credentials at rest. Generate with:
#   uv run python -c "from api.platform.secrets import FernetCipher; print(FernetCipher.generate_key())"
CASELINE_SECRETS_KEY=
# On GCP, use Cloud KMS instead of the Fernet key:
# CASELINE_KMS_KEY_NAME=projects/.../locations/.../keyRings/.../cryptoKeys/...
# Shared secret for the /v1/admin/* onboarding endpoints
CASELINE_ADMIN_TOKEN=
# Redis for live session state + config cache (empty = in-process memory)
CASELINE_REDIS_URL=
# Firm service token for the voice worker (issued at onboarding). When set,
# the worker and dashboard use the multi-tenant /v1 API; when empty the
# worker falls back to the Phase 0 prototype endpoints.
CASELINE_FIRM_TOKEN=
# Per-token API rate limit
CASELINE_RATE_LIMIT_PER_MINUTE=300
# Event worker poll interval (seconds)
CASELINE_WORKER_POLL_SECONDS=1.0

# --- Outbound SMS (empty = logged, not sent) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Phase 2 hardening ---
# Provider failover stacks: comma-separated "provider:model", primary first.
# Single entry = no failover (Phase 0/1 behavior). OpenAI entries need OPENAI_API_KEY.
CASELINE_STT_PROVIDERS=deepgram:nova-3
CASELINE_LLM_PROVIDERS=anthropic:claude-haiku-4-5
CASELINE_TTS_PROVIDERS=cartesia:sonic-3
# OPENAI_API_KEY=
# DB pool per API process — size for expected concurrent calls (see load test)
CASELINE_DB_POOL_SIZE=4
# Event worker claim batch (backpressure bound) + alert cadence
CASELINE_WORKER_BATCH_SIZE=20
CASELINE_ALERT_INTERVAL_SECONDS=60
# Webhook (Slack-compatible) for pushed alerts; empty = log only
CASELINE_ALERT_WEBHOOK_URL=
